<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.vyroflix</groupId>
        <artifactId>vyroflix-services</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>platform</artifactId>
    <packaging>jar</packaging>

    <name>VyroFlix Platform</name>
    <description>Combined deployment aggregating domain services for low-cost hosting</description>

    <dependencies>
        <!-- VyroFlix Common -->
        <dependency>
            <groupId>com.vyroflix</groupId>
            <artifactId>vyroflix-common</artifactId>
        </dependency>

        <!-- Aggregated Domain Services -->
        <dependency>
            <groupId>com.vyroflix</groupId>
            <artifactId>identity-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.vyroflix</groupId>
            <artifactId>content-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.vyroflix</groupId>
            <artifactId>video-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.vyroflix</groupId>
            <artifactId>streaming-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.vyroflix</groupId>
            <artifactId>history-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.vyroflix</groupId>
            <artifactId>search-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.vyroflix</groupId>
            <artifactId>recommendation-service</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot Web & Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Overrides parent 'exec' classifier so the primary artifact is the runnable fat JAR -->
                    <classifier></classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
