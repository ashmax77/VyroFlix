# ============================================================
# VyroFlix — Environment Variables (template)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# - `docker compose` reads `.env` automatically.
# - Spring Boot does NOT read `.env`; export the variables in your shell
#   (or use your IDE run configuration) before `mvn spring-boot:run`.
# - Spring relaxed binding: VYROFLIX_STORAGE_ACCESS_KEY -> vyroflix.storage.access-key
# ============================================================

# ============================================================
# 1. LOCAL DEVELOPMENT (Docker Compose — zero cloud credentials)
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
# Host port published by docker compose. Change if 5432 is already taken
# (e.g. a native PostgreSQL install) — 5433 is a common alternative.
POSTGRES_PORT=5432
POSTGRES_DB=vyroflix
POSTGRES_USER=vyroflix
POSTGRES_PASSWORD=CHANGE_ME
# Optional: full JDBC URL override (takes precedence over the HOST/PORT/DB values above).
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
FLYWAY_ENABLED=true

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Event bus implementation: kafka | upstash
MESSAGING_TYPE=kafka

# ---------- MinIO (local S3-compatible object store) ----------
MINIO_ROOT_USER=vyroflix
MINIO_ROOT_PASSWORD=CHANGE_ME
# Spring storage settings (must match the MinIO credentials above)
VYROFLIX_STORAGE_PROVIDER=MINIO
VYROFLIX_STORAGE_ENDPOINT=http://localhost:9000
VYROFLIX_STORAGE_REGION=us-east-1
VYROFLIX_STORAGE_ACCESS_KEY=vyroflix
VYROFLIX_STORAGE_SECRET_KEY=CHANGE_ME
VYROFLIX_STORAGE_RAW_BUCKET=vyroflix-raw
VYROFLIX_STORAGE_CONTENT_BUCKET=vyroflix-content

# ---------- Local authentication shortcut ----------
# true bypasses Supabase JWT validation and injects the mock user below.
# NEVER enable in a deployed environment.
VYROFLIX_SECURITY_MOCK_AUTH_ENABLED=false
VYROFLIX_SECURITY_MOCK_AUTH_USER_ID=00000000-0000-0000-0000-000000000001
VYROFLIX_SECURITY_MOCK_AUTH_EMAIL=dev@vyroflix.local
VYROFLIX_SECURITY_MOCK_AUTH_ROLE=USER

# ---------- API Gateway ----------
CORS_ALLOWED_ORIGIN=http://localhost:3000
# Combined backend (Render): comma-separated browser origins/patterns allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app
VYROFLIX_GATEWAY_RATE_LIMIT_REQUESTS_PER_MINUTE=200
SERVICES_IDENTITY_URL=http://localhost:8081
SERVICES_CONTENT_URL=http://localhost:8082
SERVICES_VIDEO_URL=http://localhost:8083
SERVICES_STREAMING_URL=http://localhost:8085
SERVICES_HISTORY_URL=http://localhost:8086

# Playback CDN (Cloudflare Worker, see infra/cloudflare/hls-worker). Leave blank to use presigned R2 URLs.
PLAYBACK_CDN_BASE_URL=
# Shared HMAC secret for CDN tokens; must equal the Worker's HLS_SIGNING_SECRET. Generate with: openssl rand -base64 48
PLAYBACK_SIGNING_SECRET=CHANGE_ME_MIN_32_CHARS_SECRET________
HISTORY_SERVICE_URL=http://localhost:8086
SERVICES_SEARCH_URL=http://localhost:8087
SERVICES_RECOMMENDATION_URL=http://localhost:8088

# ---------- Encoding-Service (FFmpeg worker) ----------
VYROFLIX_ENCODING_FFMPEG_PATH=ffmpeg
VYROFLIX_ENCODING_TIMEOUT_MINUTES=30

# ---------- Observability (Grafana) ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---------- Spring ----------
SPRING_PROFILES_ACTIVE=local

# ---------- Frontend (Next.js) ----------
# Base URL of the API Gateway (or the combined platform on Render). The
# Next.js rewrite proxies /api/v1/** to it — see apps/web/next.config.mjs.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# ============================================================
# 2. SUPABASE (needed once real Auth / cloud PostgreSQL is used)
# ============================================================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional overrides — derived from SUPABASE_URL when omitted.
# SUPABASE_JWKS_URI=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# Frontend-only (public, safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-side only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# ============================================================
# 3. PRODUCTION / CLOUD (Render + Upstash + Cloudflare R2)
#    Set these in the Render / Vercel dashboards, not in git.
# ============================================================

# ---------- Supabase PostgreSQL (use the pooled connection string) ----------
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
# SPRING_DATASOURCE_PASSWORD=CHANGE_ME
HIKARI_MAX_POOL_SIZE=5

# ---------- Upstash Redis ----------
UPSTASH_REDIS_URL=rediss://default:CHANGE_ME@YOUR_HOST.upstash.io:6379

# ---------- Kafka over SASL_SSL (Upstash or any managed broker) ----------
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="YOUR_USERNAME" password="CHANGE_ME";
# Only when MESSAGING_TYPE=upstash (REST producer)
UPSTASH_KAFKA_REST_URL=https://YOUR_CLUSTER-rest-kafka.upstash.io
UPSTASH_KAFKA_REST_TOKEN=CHANGE_ME

# ---------- Cloudflare R2 ----------
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_RAW=vyroflix-raw
R2_BUCKET_CONTENT=vyroflix-content
