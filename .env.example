# ============================================================
# VyroFlix — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env — only .env.example belongs in source control.
# ============================================================

# ---------- PostgreSQL (Local) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vyroflix
POSTGRES_USER=vyroflix
POSTGRES_PASSWORD=CHANGE_ME

# ---------- Redis (Local) ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Kafka (Local) ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------- MinIO / S3 (Local) ----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_RAW=vyroflix-raw
MINIO_BUCKET_CONTENT=vyroflix-content

# ---------- Supabase ----------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_JWT_SECRET=CHANGE_ME
SUPABASE_JWKS_URI=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# ---------- Upstash Redis (Production) ----------
UPSTASH_REDIS_URL=YOUR_UPSTASH_REDIS_URL
UPSTASH_REDIS_TOKEN=CHANGE_ME

# ---------- Upstash Kafka (Production) ----------
UPSTASH_KAFKA_URL=YOUR_UPSTASH_KAFKA_URL
UPSTASH_KAFKA_USERNAME=YOUR_UPSTASH_KAFKA_USERNAME
UPSTASH_KAFKA_PASSWORD=CHANGE_ME

# ---------- Cloudflare R2 (Production) ----------
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_RAW=vyroflix-raw
R2_BUCKET_CONTENT=vyroflix-content

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---------- Service Ports (Local) ----------
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
CONTENT_SERVICE_PORT=8082
VIDEO_SERVICE_PORT=8083
ENCODING_SERVICE_PORT=8084
STREAMING_SERVICE_PORT=8085
HISTORY_SERVICE_PORT=8086
SEARCH_SERVICE_PORT=8087
RECOMMENDATION_SERVICE_PORT=8088
